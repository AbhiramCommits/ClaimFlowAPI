# Copy to .env and replace every placeholder. Never commit .env.
# The values below are placeholders only; the repository contains no real secrets.

# SQL Server 2022 Developer edition SA password (must satisfy SQL Server complexity rules).
SQLSERVER_SA_PASSWORD=__SET_A_STRONG_LOCAL_PASSWORD__

# RabbitMQ application user.
RABBITMQ_DEFAULT_USER=claimflow
RABBITMQ_DEFAULT_PASS=__SET_A_STRONG_LOCAL_PASSWORD__

# JWT HMAC signing key shared by intake and adjudication. At least 32 characters.
JWT_SIGNING_KEY=__SET_AT_LEAST_32_CHARACTERS__

# Host ports (change if something else already listens locally).
SQLSERVER_HOST_PORT=1433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
INTAKE_HOST_PORT=5080
ADJUDICATION_HOST_PORT=5081
